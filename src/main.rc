#include <windows.h>
#include "resource.h"

ID_MAINMENU MENU
{
    POPUP "&File"
    {
        MENUITEM "&Open project...", ID_OPEN
        MENUITEM "&Save project...", ID_SAVE
        MENUITEM "&Save project as...", ID_SAVEAS
        MENUITEM SEPARATOR
        MENUITEM "&Generate...", ID_GENERATE
        MENUITEM SEPARATOR
        MENUITEM "E&xit\tAlt-F4", ID_EXIT
    }

    POPUP "&Edit"
    {
        MENUITEM "&Add layer...", ID_ADD
        MENUITEM "Add &empty layer...", ID_ADD_EMPTY
        MENUITEM "&Remove layer", ID_REMOVE
        MENUITEM "&Move layer &up", ID_MOVE_UP
        MENUITEM "&Move layer &down", ID_MOVE_DOWN
        MENUITEM SEPARATOR
        MENUITEM "&Compose", ID_COMPOSE
    }
}

IDD_LAYER_BASE_PROPS DIALOG 400, 400, 170, 210
CAPTION "Base Layer Properties"
{
    PUSHBUTTON "O&k", IDOK, 12, 192, 50, 14
    PUSHBUTTON "&Cancel", IDCANCEL, 68, 192, 50, 14

    LTEXT "Name", IDC_STATIC, 10, 10, 55, 12
    LTEXT "Width", IDC_STATIC, 10, 30, 55, 12
    LTEXT "Height", IDC_STATIC, 10, 50, 55, 12
    EDITTEXT ID_NAME, 54, 9, 115, 14
    EDITTEXT ID_WIDTH, 54, 29, 38, 14
    EDITTEXT ID_HEIGHT, 54, 49, 38, 14

    LTEXT "Fill Red", IDC_STATIC, 10, 70, 55, 12
    LTEXT "Fill Green", IDC_STATIC, 10, 90, 55, 12
    LTEXT "Fill Blue", IDC_STATIC, 10, 110, 55, 12
    EDITTEXT ID_RED, 54, 69, 38, 14
    EDITTEXT ID_GREEN, 54, 89, 38, 14
    EDITTEXT ID_BLUE, 54, 109, 38, 14
    CONTROL "Color", ID_COLOR_BOX, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 96, 69, 40, 53
    PUSHBUTTON "...", ID_FILL_COLOR, 139, 69, 30, 53

    LTEXT "Transp Red", IDC_STATIC, 10, 130, 55, 12
    LTEXT "Transp Green", IDC_STATIC, 10, 150, 55, 12
    LTEXT "Transp Blue", IDC_STATIC, 10, 170, 55, 12
    EDITTEXT ID_RED_TRANSP, 54, 129, 38, 14
    EDITTEXT ID_GREEN_TRANSP, 54, 149, 38, 14
    EDITTEXT ID_BLUE_TRANSP, 54, 169, 38, 14
    CONTROL "Color", ID_TRANSP_COLOR_BOX, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 96, 129, 40, 53
    PUSHBUTTON "...", ID_TRANSP_COLOR, 139, 129, 30, 53    
}
